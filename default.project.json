          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "Gravity": 160
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.45, 0.42, 0.5],
        "OutdoorAmbient": [0.6, 0.55, 0.65],
        "Brightness": 2.2,
        "ClockTime": 15.2,
        "GlobalShadows": true,
        "Outlines": false,
        "FogColor": [1, 0.78, 0.62],
        "FogStart": 300,
        "FogEnd": 1100,
        "Technology": "ShadowMap"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
